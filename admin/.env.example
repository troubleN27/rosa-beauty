# Pooled Neon connection string (host with -pooler)
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/neondb?sslmode=require
# Random string, 32+ characters
BETTER_AUTH_SECRET=
# Admin panel URL (locally http://localhost:3000)
BETTER_AUTH_URL=http://localhost:3000
# Vercel Blob read-write token (master photos)
BLOB_READ_WRITE_TOKEN=
# Telegram bot token, used only on the server to message clients
TELEGRAM_BOT_TOKEN=
